DEFINE
	VAR __DS0FilterTable = 
		FILTER(
			KEEPFILTERS(VALUES('Products'[Product Category English])),
			NOT('Products'[Product Category English] IN {BLANK()})
		)

	VAR __DS0FilterTable2 = 
		TREATAS({"Avg Delivery Days"}, 'KPI Selector'[KPI])

	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			'Products'[Product Category English],
			__DS0FilterTable,
			__DS0FilterTable2,
			"Total_Revenue", 'Sales'[Total Revenue],
			"v_Total_Revenue_FormatString", IGNORE('Sales'[_Total Revenue FormatString]),
			"On_Time_Delivery_Pct", 'Sales'[On-Time Delivery Pct],
			"v_On_Time_Delivery_Pct_FormatString", IGNORE('Sales'[_On-Time Delivery Pct FormatString]),
			"Avg_Order_Value", 'Sales'[Avg Order Value],
			"v_Avg_Order_Value_FormatString", IGNORE('Sales'[_Avg Order Value FormatString])
		)

	VAR __DS0IntersectionCount = CALCULATE(COUNTROWS(__DS0Core))

	VAR __DS0BodyOverlappingPointsSample = 
		SAMPLECARTESIANPOINTSBYCOVER(3500, __DS0Core, [Total_Revenue], [On_Time_Delivery_Pct])

EVALUATE
	ROW(
	"DS0IntersectionCount", __DS0IntersectionCount
)

EVALUATE
	GROUPBY(
		__DS0Core,
		"AverageTotal_Revenue", AVERAGEX(CURRENTGROUP(), [Total_Revenue]),
		"AverageOn_Time_Delivery_Pct", AVERAGEX(CURRENTGROUP(), [On_Time_Delivery_Pct])
	)

EVALUATE
	__DS0BodyOverlappingPointsSample

ORDER BY
	'Products'[Product Category English]