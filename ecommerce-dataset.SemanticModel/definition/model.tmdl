model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Customers","Date","Seller Geography","Products","Sales","Sellers","__server"]

annotation PBI_ProTooling = ["MCP-PBIModeling","CopilotTooling","TMDLView_Desktop","DaxQueryView_Desktop","DevMode"]

annotation __PBI_AIInstructions =
		## Data Context
		- This dataset contains Brazilian e-commerce orders from 2016 to 2018.
		- The most recent complete year of data is 2018. There is no data after September 2018.
		- Default currency is BRL (Brazilian Real).
		
		## Time Intelligence
		- When users ask about YTD (year-to-date), prior year, year-over-year, or YoY, use the 'Time Calculation' calculation group.
		- The 'Time Calculation' table has a column called 'Time Calculation' with these values: 'Current', 'YTD', 'Prior Year', 'YoY %'.
		- To apply time intelligence, filter 'Time Calculation'[Time Calculation] to the desired value alongside the measure.
		- Example: For YTD revenue in 2018, use CALCULATE([Total Revenue], 'Time Calculation'[Time Calculation] = "YTD", 'Date'[Year] = 2018).
		- Example: For prior year orders, use CALCULATE([Total Orders], 'Time Calculation'[Time Calculation] = "Prior Year").
		- Since data only goes up to 2018, default to year 2018 if the user does not specify a year.
		
		## Growth and Percentage Change
		- The model has a DAX function called GrowthPct(CurrentValue, PriorValue) that calculates percentage growth.
		- When users ask about growth, percentage change, increase, or decline between two periods, use GrowthPct.
		- Example: Revenue growth from 2017 to 2018 = GrowthPct(CALCULATE([Total Revenue], 'Date'[Year] = 2018), CALCULATE([Total Revenue], 'Date'[Year] = 2017)).
		
		## Business Terminology
		- 'ARPLISPC' means Average Revenue Per Line Item Sold Per Customer. Use the [ARPLISPC] measure.
		- 'basket size' and 'average basket' refer to the monetary value per order, use [Avg Order Value] not [Items Per Order].
		- 'best case' and 'worst case' refer to rows in the Scenario table, not minimum or maximum values in the data.
		- When comparing scenarios, filter the Scenario[Scenario Name] column.

ref table Customers
ref table Date
ref table 'Seller Geography'
ref table Products
ref table Sales
ref table Sellers
ref table 'Customer Geography'
ref table 'Total Measures'
ref table 'Time Calculation'
ref table 'KPI Selector'
ref table Currency
ref table Scenario

ref cultureInfo en-US

