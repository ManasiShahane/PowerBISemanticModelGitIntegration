/// Disconnected currency converter. No relationships. Select a currency and [Converted Revenue] shows revenue in that currency. Values: BRL (R$), USD ($), EUR (€), GBP (£).
table Currency
	lineageTag: d1ac49d7-bf9c-42a2-96b2-fe458bee11f8

	/// Currency name for conversion. Values: BRL (Brazilian Real), USD (US Dollar), EUR (Euro), GBP (British Pound).
	column Currency
		lineageTag: 60262b08-430d-447d-a605-a5b2d0160b91
		isNameInferred
		sourceColumn: [Currency]

	/// Currency symbol used for formatting. Values: R$, $, €, £.
	column Symbol
		lineageTag: b17750e2-e985-43ec-9d48-bf8db4ae224d
		isNameInferred
		sourceColumn: [Symbol]

	/// Exchange rate from BRL to target currency. Multiply BRL value by this rate.
	column 'Rate to BRL'
		lineageTag: 67dc2249-a01b-4b46-bc8b-7632fd8b678d
		isNameInferred
		sourceColumn: [Rate to BRL]

	partition Currency = calculated
		mode: import
		source = DATATABLE("Currency", STRING, "Symbol", STRING, "Rate to BRL", DOUBLE, {{"BRL", "R$", 1.0}, {"USD", "$", 0.17}, {"EUR", "€", 0.16}, {"GBP", "£", 0.14}})

