/// Seller location details: city, state, and lat/long coordinates for mapping.
table 'Seller Geography'
	lineageTag: 9aa88ecf-62cc-40f2-be15-ab3af852e46e

	/// Postal code for seller location.
	column 'Zip Code'
		dataType: int64
		formatString: 0
		lineageTag: 5e206841-69ac-4389-9c2e-ae68d66217f1
		summarizeBy: none
		sourceColumn: Zip Code

		annotation SummarizationSetBy = Automatic

	/// Seller city name in Brazil.
	column City
		dataType: string
		lineageTag: d62e2d49-153a-47af-9655-9e79a9cba0e3
		summarizeBy: none
		sourceColumn: City

		annotation SummarizationSetBy = Automatic

	/// Seller Brazilian state code (e.g., SP, RJ, MG).
	column State
		dataType: string
		lineageTag: cd06ccd1-9883-4f85-a612-813a544d2918
		summarizeBy: none
		sourceColumn: State

		annotation SummarizationSetBy = Automatic

	/// Seller latitude coordinate for map visualizations.
	column Latitude
		dataType: double
		lineageTag: ddfa0a0e-4b7d-4fdb-9a7a-e0aa4f329bb9
		dataCategory: Latitude
		summarizeBy: none
		sourceColumn: Latitude

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Seller longitude coordinate for map visualizations.
	column Longitude
		dataType: double
		lineageTag: 2c93802e-4496-4517-92cf-057b2681a875
		dataCategory: Longitude
		summarizeBy: none
		sourceColumn: Longitude

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Seller location drill-down: State → City. Use for seller geographic analysis.
	hierarchy 'State Hierarchy'
		lineageTag: 52082a8c-808a-42a2-8260-014dd5bb88b1

		level State
			lineageTag: 1c6801f2-2489-49bd-8c53-87b341903703
			column: State

		level City
			lineageTag: bf737c88-77fd-4a0f-a5ea-65db251a7073
			column: City

	partition 'Seller Geography' = m
		mode: import
		source =
				let
				    Source = Sql.Database(__server, "ecommerce_lakehouse"),
				    fda_Geography = Source{[Schema="fda",Item="Geography"]}[Data]
				in
				    fda_Geography

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

