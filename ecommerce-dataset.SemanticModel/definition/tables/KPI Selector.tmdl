/// Disconnected slicer table. No relationships. Select a KPI name and the [Selected KPI] measure returns its value.
table 'KPI Selector'
	lineageTag: bf7e9bfe-a3ee-4a07-8b5d-67b9cdd16226

	/// Pick a KPI to display. Drives [Selected KPI] measure. Values: Revenue, Orders, Avg Delivery Days, Avg Order Value, Late Delivery Pct.
	column KPI
		lineageTag: 58db883b-5e52-411d-8f0e-60f275e49186
		isNameInferred
		sourceColumn: [KPI]

	partition 'KPI Selector' = calculated
		mode: import
		source = DATATABLE("KPI", STRING, {{"Revenue"}, {"Orders"}, {"Avg Delivery Days"}, {"Avg Order Value"}, {"Late Delivery Pct"}})

