/// Calendar date dimension for time-based analysis. Covers the full order date range.
table Date
	lineageTag: aaf0a9ea-a650-45f2-a9e6-33b3a1d2251d

	/// Integer date key in YYYYMMDD format. Not for display.
	column 'Date Key'
		dataType: int64
		formatString: 0
		lineageTag: a1009e7b-304d-45ce-8871-1303a9289a6f
		summarizeBy: none
		sourceColumn: Date Key

		annotation SummarizationSetBy = Automatic

	/// Calendar date. Use for time intelligence functions (TOTALYTD, SAMEPERIODLASTYEAR).
	column Date
		dataType: dateTime
		formatString: Short Date
		lineageTag: 0fc8b6f8-5da4-42ba-9671-71bbecb9acef
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// Calendar year (e.g., 2017, 2018). Use for annual comparisons.
	column Year
		dataType: int64
		formatString: 0
		lineageTag: eb1c3772-ce12-43b3-ad34-598ee77a3a60
		summarizeBy: none
		sourceColumn: Year

		annotation SummarizationSetBy = User

	/// Quarter number (1–4). Use for quarterly trend analysis.
	column Quarter
		dataType: int64
		formatString: 0
		lineageTag: 3724be15-cfd7-41a9-8b16-1bf21471283d
		summarizeBy: none
		sourceColumn: Quarter

		annotation SummarizationSetBy = User

	/// Month number 1–12. Use to sort Month Name chronologically.
	column 'Month Number'
		dataType: int64
		formatString: 0
		lineageTag: 7475c5f2-fb2a-4836-a444-bda3991b1b54
		summarizeBy: none
		sourceColumn: Month Number

		annotation SummarizationSetBy = User

	/// Month name (e.g., January). Display-friendly; sort by Month Number for correct order.
	column 'Month Name'
		dataType: string
		lineageTag: 6c3c30b4-4d11-41e1-864c-08d872ed22dc
		summarizeBy: none
		sourceColumn: Month Name

		annotation SummarizationSetBy = Automatic

	/// Year-month label (e.g., 2018-01). Use for monthly trend reporting.
	column 'Year Month'
		dataType: string
		lineageTag: f236d9cc-e87a-4dd7-841e-99a15d398873
		summarizeBy: none
		sourceColumn: Year Month

		annotation SummarizationSetBy = Automatic

	/// Day number within the month (1–31).
	column 'Day of Month'
		dataType: int64
		formatString: 0
		lineageTag: 6d9c9180-3a41-4f3d-8200-43a81a67597f
		summarizeBy: none
		sourceColumn: Day of Month

		annotation SummarizationSetBy = User

	/// Day number within the week (1–7). Use to sort Day Name.
	column 'Day of Week'
		dataType: int64
		formatString: 0
		lineageTag: 0f3f1ca5-8bca-4086-96fc-97e94002a886
		summarizeBy: none
		sourceColumn: Day of Week

		annotation SummarizationSetBy = User

	/// Day name (e.g., Monday). Display-friendly; sort by Day of Week for correct order.
	column 'Day Name'
		dataType: string
		lineageTag: e81b902c-6185-4943-a1b5-b827558c3241
		summarizeBy: none
		sourceColumn: Day Name

		annotation SummarizationSetBy = Automatic

	/// Day number within the year (1–366). Use for seasonal pattern analysis.
	column 'Day of Year'
		dataType: int64
		formatString: 0
		lineageTag: 21eb76d3-ec80-4073-82ea-d266d1fdad87
		summarizeBy: none
		sourceColumn: Day of Year

		annotation SummarizationSetBy = User

	/// True for Saturday/Sunday. Use to compare weekday vs weekend performance.
	column 'Is Weekend'
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 2e36754d-8275-49ea-964d-9f55afefce7a
		summarizeBy: none
		sourceColumn: Is Weekend

		annotation SummarizationSetBy = Automatic

	/// Drill down: Year → Quarter → Month → Date. Use for time-based drill-through analysis.
	hierarchy 'Year Hierarchy'
		lineageTag: 9c6c3013-172a-499b-b368-6b242479b0ac

		level Year
			lineageTag: c2e3c030-d7a2-4fc5-b1fe-5136b3671dcf
			column: Year

		level Quarter
			lineageTag: f65f48e5-f1ae-431a-81d2-9c6d0d72314a
			column: Quarter

		level 'Month Name'
			lineageTag: 118fc0c4-65de-4743-bdd6-c5ba9e46747c
			column: 'Month Name'

		level Date
			lineageTag: 5faebbe0-c0af-4750-ab85-e01b617a5d5e
			column: Date

	partition Date = m
		mode: import
		source =
				let
				    Source = Sql.Database(__server, "ecommerce_lakehouse"),
				    fda_Date = Source{[Schema="fda",Item="Date"]}[Data]
				in
				    fda_Date

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

