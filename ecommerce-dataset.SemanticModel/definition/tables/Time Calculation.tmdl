/// Calculation group for time intelligence. Filter by this column to switch any measure between: Current, YTD, Prior Year, or YoY %. Works with all measures.
table 'Time Calculation'
	lineageTag: e3c44a78-5ec2-4ba3-9ed0-c9d00b6b37c1

	/// Switches any base measure between time intelligence variants: Current, YTD, Prior Year, and Year-over-Year %.
	calculationGroup
		precedence: 10

		/// Returns the measure as-is with no time modification.
		calculationItem Current = SELECTEDMEASURE()

		/// Year-to-date accumulation of the selected measure.
		calculationItem YTD = CALCULATE(SELECTEDMEASURE(), DATESYTD('Date'[Date]))

		/// Same period from the prior year.
		calculationItem 'Prior Year' = CALCULATE(SELECTEDMEASURE(), SAMEPERIODLASTYEAR('Date'[Date]))

		/// Year-over-year percentage change.
		calculationItem 'YoY %' =
				VAR _current = SELECTEDMEASURE()
				VAR _py = CALCULATE(SELECTEDMEASURE(), SAMEPERIODLASTYEAR('Date'[Date]))
				RETURN
				IF(NOT ISBLANK(_py), DIVIDE(_current - _py, _py))

			formatStringDefinition = "0.0%"

	/// Select a time intelligence variant: Current (as-is), YTD (year-to-date), Prior Year (same period last year), or YoY % (year-over-year change). Applies to any measure.
	column 'Time Calculation'
		dataType: string
		lineageTag: 57c7e2d0-ca1c-4c9f-a8ee-04c36d2f12ed

	partition 'Partition_Time Calculation' = calculationGroup

